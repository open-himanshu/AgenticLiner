# ===========================================================================
# AgenticLiner Environment Configuration Template (.env.example)
# SparkX 3.0 Challenge #1 — AI Event Planning Platform (Galgotias University)
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Database & Security
# ---------------------------------------------------------------------------
DATABASE_PATH=agenticliner.db
SECRET_KEY=change_me_to_a_secure_random_string_in_production
SESSION_COOKIE_NAME=agenticliner_session

# Seed passwords (Optional: leave unset to let seeder generate secure random tokens)
# SUPERVISOR_PASSWORD=your_secure_supervisor_password
# ORGANISER_PASSWORD=your_secure_organiser_password
# DATA_MANAGER_PASSWORD=your_secure_datamgr_password
# PARTICIPANT_PASSWORD=your_secure_student_password

# ---------------------------------------------------------------------------
# 2. LLM Provider Configuration (Autopilot Agent & Grounded Assistant)
# Supported PROVIDER options: gemini | groq | ollama
# ---------------------------------------------------------------------------
PROVIDER=gemini

# Google Gemini (Primary Cloud Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq (Alternative Cloud Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Local Offline Provider)
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# 3. SMTP Email Configuration (Optional: Stakeholder Broadcast & Verification)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_NAME=AgenticLiner Campus Portal
SMTP_FROM_EMAIL=noreply@galgotias.edu
SEND_REAL_SMTP=false

# ---------------------------------------------------------------------------
# 4. Safety Engine & Invariant Caps (Kavach)
# ---------------------------------------------------------------------------
KAVACH_MAX_RECIPIENTS=500

# ---------------------------------------------------------------------------
# 5. Access Control & Deployment Guards
# ---------------------------------------------------------------------------
ALLOW_DEMO_LOGIN=0
ALLOW_PUBLIC_TUNNEL=0
# PUBLIC_BASE_URL=https://your-domain.example.com

# Client-side OAuth / Firebase (Optional integrations)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# FIREBASE_PROJECT_ID=your_firebase_project_id
