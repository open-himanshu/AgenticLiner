# AgenticLiner Environment Configuration Template
APP_ENV=development
APP_PORT=8000
DEBUG=True

# Database Settings
DATABASE_PATH=agenticliner.db

# Authentication & Sessions
SECRET_KEY=change_me_to_a_secure_random_string_in_production
SESSION_COOKIE_NAME=agenticliner_session
SESSION_MAX_AGE=86400

# Server-side authentication variable names; configure values in the deployment environment.
# FIREBASE_PROJECT_ID
# ALLOW_DEMO_LOGIN
# ALLOW_PUBLIC_TUNNEL

# Real SMTP Email Configuration (for Real OTP Verification)
# To send real OTPs using Gmail:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to https://myaccount.google.com/apppasswords and create an App Password (Name: AgenticLiner).
# 3. Enter your Gmail and the 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_NAME=AgenticLiner Campus Portal
SMTP_FROM_EMAIL=your_email@gmail.com

# LLM Keys (Gemini / AI integration)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
